             Link="NovelAgent\Services\VolumeArcPlanner.cs" />
    <Compile Include="..\..\Services\Framework\AI\NovelAgent\Services\ForeshadowLedgerService.cs"
             Link="NovelAgent\Services\ForeshadowLedgerService.cs" />

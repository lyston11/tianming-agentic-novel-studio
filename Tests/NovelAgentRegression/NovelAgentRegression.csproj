    <Compile Include="..\..\Services\Framework\AI\NovelAgent\Services\ForeshadowLedgerService.cs" Link="NovelAgent\Services\ForeshadowLedgerService.cs" />
    <Compile Include="..\..\Services\Framework\AI\NovelAgent\Services\CanonMaintenanceService.cs" Link="NovelAgent\Services\CanonMaintenanceService.cs" />
    <Compile Include="..\..\Services\Framework\AI\NovelAgent\Services\CharacterLedgerService.cs" Link="NovelAgent\Services\CharacterLedgerService.cs" />
    <Compile Include="..\..\Services\Framework\AI\NovelAgent\Services\ChapterNoveltyPlanner.cs" Link="NovelAgent\Services\ChapterNoveltyPlanner.cs" />
    <Compile Include="..\..\Services\Framework\AI\NovelAgent\Services\StoryStateSnapshotService.cs" Link="NovelAgent\Services\StoryStateSnapshotService.cs" />
    <Compile Include="..\..\Services\Framework\AI\NovelAgent\Services\CommercialRhythmChecker.cs" Link="NovelAgent\Services\CommercialRhythmChecker.cs" />

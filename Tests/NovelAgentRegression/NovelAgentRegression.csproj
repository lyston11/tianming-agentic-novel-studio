    <Compile Include="..\..\Web\NovelAgentWeb\Support\PhaseInference.cs" Link="NovelAgentWeb\Support\PhaseInference.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TM.Framework.Common.Helpers" />
    <Using Include="TM.Framework.Common.Helpers.Storage" />
    <Using Include="TM.Framework.Common.Services" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Fixtures\NovelAgent\**\*.json" Link="Fixtures\NovelAgent\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

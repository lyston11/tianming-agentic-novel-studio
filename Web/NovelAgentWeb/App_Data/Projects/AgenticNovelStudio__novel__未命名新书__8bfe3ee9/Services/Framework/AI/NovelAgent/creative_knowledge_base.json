    {
      "id": "genre-xuanhuan-cost",
      "category": 0,
      "genre": "玄幻",
      "subGenre": "爽文",
      "title": "爽文必须有代价回流",
      "content": "升级、打脸、夺宝之后必须留下敌人升级、资源债务、身份暴露或规则反噬，否则爽点会变成无成本流水账。",
      "tags": [
        "玄幻",
        "爽文",
        "代价",
        "规则反噬"
      ],
      "weight": 9,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662841+08:00",
      "updatedAt": "2026-06-10T13:34:46.389492+08:00"
    },
    {
      "id": "genre-suspense-evidence",
      "category": 0,
      "genre": "悬疑",
      "subGenre": "烧脑",
      "title": "反转必须提前有证据",
      "content": "烧脑章节可以误导读者，但不能靠临时新设定解释一切；至少提前放入一个可回看证据和一个合理误读路径。",
      "tags": [
        "悬疑",
        "烧脑",
        "反转",
        "伏笔"
      ],
      "weight": 10,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662851+08:00",
      "updatedAt": "2026-06-10T13:34:46.389492+08:00"
    },
    {
      "id": "genre-ensemble-position",
      "category": 0,
      "genre": "群像",
      "subGenre": "",
      "title": "群像推进依靠立场变化",
      "content": "群像章节的有效推进不是增加人物出场，而是让至少一个人物的利益、关系或阵营立场发生可追踪变化。",
      "tags": [
        "群像",
        "势力",
        "关系",
        "立场"
      ],
      "weight": 8,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662852+08:00",
      "updatedAt": "2026-06-10T13:34:46.389493+08:00"
    },
    {
      "id": "trope-sudden-rescue",
      "category": 1,
      "genre": "",
      "subGenre": "",
      "title": "关键人物刚好路过救场",
      "content": "当主角困局由外部强者突然解决，读者会觉得前文压力失效。除非救场者早有行动线索，否则应改成主角用已有信息自救。",
      "tags": [
        "救场",
        "巧合",
        "降智"
      ],
      "weight": 9,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662853+08:00",
      "updatedAt": "2026-06-10T13:34:46.389493+08:00"
    },
    {
      "id": "trope-face-slapping",
      "category": 1,
      "genre": "",
      "subGenre": "爽文",
      "title": "重复打脸循环",
      "content": "嘲讽、证明、全场震惊如果连续出现，会让爽点疲劳。需要改变冲突功能：一次改资源，一次改关系，一次改规则认知。",
      "tags": [
        "打脸",
        "全场震惊",
        "爽文",
        "套路"
      ],
      "weight": 8,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662854+08:00",
      "updatedAt": "2026-06-10T13:34:46.389494+08:00"
    },
    {
      "id": "anti-cost",
      "category": 2,
      "genre": "",
      "subGenre": "",
      "title": "用代价替代巧合",
      "content": "遇到机械反转或突然救场时，把解决方案改成角色主动付出代价：暴露秘密、牺牲资源、破坏关系或签下未来债务。",
      "tags": [
        "反套路",
        "代价",
        "主动选择"
      ],
      "weight": 10,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662858+08:00",
      "updatedAt": "2026-06-10T13:34:46.389494+08:00"
    },
    {
      "id": "anti-perspective",
      "category": 2,
      "genre": "",
      "subGenre": "",
      "title": "改变信息来源",
      "content": "如果桥段和旧章节相似，不只换场景名；应改变信息来源、误判对象、反转主体和最终承担后果的人。",
      "tags": [
        "反套路",
        "信息差",
        "重复桥段"
      ],
      "weight": 9,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.66286+08:00",
      "updatedAt": "2026-06-10T13:34:46.389495+08:00"
    },
    {
      "id": "depth-theme-choice",
      "category": 5,
      "genre": "",
      "subGenre": "",
      "title": "主题深度落在选择而不是旁白",
      "content": "不要用议论解释主题。让角色在两种都不完美的选择里暴露价值观，并让选择带来后续不可撤销的后果。",
      "tags": [
        "主题",
        "深度",
        "选择",
        "后果"
      ],
      "weight": 8,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662861+08:00",
      "updatedAt": "2026-06-10T13:34:46.389496+08:00"
    },
    {
      "id": "emotion-arc-trigger-externalize",
      "category": 6,
      "genre": "",
      "subGenre": "",
      "title": "情绪线必须外化为行动",
      "content": "有效的情绪变化要有触发、压抑、外化行动和后果。不要只写角色心里难受；让难受改变一次选择、一次关系或一次风险承担。",
      "tags": [
        "情绪线",
        "心理",
        "外化",
        "行动",
        "后果"
      ],
      "weight": 9,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662862+08:00",
      "updatedAt": "2026-06-10T13:34:46.389496+08:00"
    },
    {
      "id": "emotion-arc-pressure-memory",
      "category": 6,
      "genre": "",
      "subGenre": "",
      "title": "心理变化需要旧伤与当前压力共振",
      "content": "角色突然崩溃或转变会显得机械。应让当前事件击中旧伤、信念或秘密，再用一个具体行为证明心理状态已经变化。",
      "tags": [
        "旧伤",
        "压力",
        "心理变化",
        "信念"
      ],
      "weight": 8,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662863+08:00",
      "updatedAt": "2026-06-10T13:34:46.389497+08:00"
    },
    {
      "id": "relationship-dynamic-power",
      "category": 7,
      "genre": "",
      "subGenre": "",
      "title": "关系变化必须改变权力或信任结构",
      "content": "和解、背叛、暧昧、结盟都不能只停在对话层面；它必须改变信息共享、资源分配、保护义务、威胁关系中的至少一项。",
      "tags": [
        "关系变化",
        "信任",
        "权力",
        "资源",
        "背叛"
      ],
      "weight": 10,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662864+08:00",
      "updatedAt": "2026-06-10T13:34:46.389497+08:00"
    },
    {
      "id": "relationship-dynamic-traceable",
      "category": 7,
      "genre": "",
      "subGenre": "",
      "title": "关系弧要有可追踪状态机",
      "content": "关系线至少记录起点、裂痕、试探、代价、转折和新状态。每次变化都要能在角色账本中留下下一章可使用的压力。",
      "tags": [
        "关系弧",
        "状态机",
        "裂痕",
        "试探",
        "角色账本"
      ],
      "weight": 9,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662865+08:00",
      "updatedAt": "2026-06-10T13:34:46.389498+08:00"
    },
    {
      "id": "reader-promise-payoff",
      "category": 4,
      "genre": "",
      "subGenre": "",
      "title": "读者承诺需要阶段兑现",
      "content": "每三到五章至少兑现一次类型承诺：爽文给明确胜利，悬疑给可信线索，情绪文给关系变化，群像文给格局移动。",
      "tags": [
        "读者承诺",
        "节奏",
        "兑现"
      ],
      "weight": 8,
      "source": "BuiltIn",
      "createdAt": "2026-06-06T20:33:14.662866+08:00",
      "updatedAt": "2026-06-10T13:34:46.389498+08:00"
    }
